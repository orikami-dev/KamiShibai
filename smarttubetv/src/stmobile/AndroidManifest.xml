<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools"
          package="com.liskovsoft.smartyoutubetv2.tv">

    <!-- Kamishibai runs on phones, tablets and foldables, not only on TV boxes -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false"
        tools:node="replace" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false"
        tools:node="replace" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Downloads land in Movies/KamiShibai and Music/KamiShibai: before Android 10 that needs the storage permission -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Sign in: find the browser app, so the activation page doesn't open in the YouTube app -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name="com.liskovsoft.smartyoutubetv2.tv.mobile.KamishibaiApplication"
        android:label="@string/app_name"
        android:resizeableActivity="true"
        tools:replace="android:name,android:label">

        <!-- Every screen follows fold/unfold, rotation and window resize without being recreated -->
        <activity
            android:name="com.liskovsoft.smartyoutubetv2.tv.mobile.browse.MobileBrowseActivity"
            android:launchMode="singleInstance"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection|density|keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="unspecified"
            android:theme="@style/Kamishibai.Theme.Launch" />

        <activity
            android:name="com.liskovsoft.smartyoutubetv2.tv.mobile.search.MobileSearchActivity"
            android:launchMode="singleInstance"
            android:resizeableActivity="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection|density|keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="adjustResize|stateVisible"
            android:screenOrientation="unspecified"
            android:theme="@style/Kamishibai.Theme.Launch" />

        <activity
            android:name="com.liskovsoft.smartyoutubetv2.tv.mobile.channel.MobileChannelActivity"
            android:launchMode="singleInstance"
            android:resizeableActivity="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection|density|keyboard|keyboardHidden|navigation"
            android:screenOrientation="unspecified"
            android:theme="@style/Kamishibai.Theme.Launch" />

        <activity
            android:name="com.liskovsoft.smartyoutubetv2.tv.mobile.channeluploads.MobileChannelUploadsActivity"
            android:launchMode="singleInstance"
            android:resizeableActivity="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection|density|keyboard|keyboardHidden|navigation"
            android:screenOrientation="unspecified"
            android:theme="@style/Kamishibai.Theme.Launch" />

        <!-- Google account sign in, phone layout. Stays alive while the browser is open, the presenter keeps polling. -->
        <activity
            android:name="com.liskovsoft.smartyoutubetv2.tv.mobile.signin.MobileSignInActivity"
            android:launchMode="singleInstance"
            android:resizeableActivity="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection|density|keyboard|keyboardHidden|navigation"
            android:screenOrientation="unspecified"
            android:theme="@style/Kamishibai.Theme.Launch" />

        <!-- Settings (full screen pages) and menus (bottom sheet), same flags as the upstream dialog -->
        <activity
            android:name="com.liskovsoft.smartyoutubetv2.tv.mobile.dialog.MobileAppDialogActivity"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:resizeableActivity="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection|density|keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="unspecified"
            android:theme="@style/Kamishibai.Theme.Dialog" />

        <!-- App icon in the colors of the palette (KamiIcon): the launcher entry moves from SplashActivity to one alias per palette -->
        <activity
            android:name="com.liskovsoft.smartyoutubetv2.tv.ui.main.SplashActivity"
            android:theme="@style/Kamishibai.Theme.Launch">
            <intent-filter tools:node="remove">
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name="com.liskovsoft.smartyoutubetv2.tv.mobile.IconWashi"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/app_icon"
            android:label="@string/app_name"
            android:targetActivity="com.liskovsoft.smartyoutubetv2.tv.ui.main.SplashActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="com.liskovsoft.smartyoutubetv2.tv.mobile.IconSumi"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/kami_icon_sumi"
            android:label="@string/app_name"
            android:targetActivity="com.liskovsoft.smartyoutubetv2.tv.ui.main.SplashActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="com.liskovsoft.smartyoutubetv2.tv.mobile.IconAi"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/kami_icon_ai"
            android:label="@string/app_name"
            android:targetActivity="com.liskovsoft.smartyoutubetv2.tv.ui.main.SplashActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="com.liskovsoft.smartyoutubetv2.tv.mobile.IconMatcha"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/kami_icon_matcha"
            android:label="@string/app_name"
            android:targetActivity="com.liskovsoft.smartyoutubetv2.tv.ui.main.SplashActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="com.liskovsoft.smartyoutubetv2.tv.mobile.IconSakura"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/kami_icon_sakura"
            android:label="@string/app_name"
            android:targetActivity="com.liskovsoft.smartyoutubetv2.tv.ui.main.SplashActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="com.liskovsoft.smartyoutubetv2.tv.mobile.IconKin"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/kami_icon_kin"
            android:label="@string/app_name"
            android:targetActivity="com.liskovsoft.smartyoutubetv2.tv.ui.main.SplashActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Settings > Remote control > Add a device, phone layout -->
        <activity
            android:name="com.liskovsoft.smartyoutubetv2.tv.mobile.adddevice.MobileAddDeviceActivity"
            android:resizeableActivity="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection|density|keyboard|keyboardHidden|navigation"
            android:screenOrientation="unspecified"
            android:theme="@style/Kamishibai.Theme.Launch" />

        <!-- Export the logs: preview, then e-mail or copy -->
        <activity
            android:name="com.liskovsoft.smartyoutubetv2.tv.mobile.logs.KamiLogsActivity"
            android:resizeableActivity="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection|density|keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="unspecified"
            android:theme="@style/Kamishibai.Theme.Launch" />

        <!-- Links of the settings open in the browser of the phone: invisible, closes at once -->
        <activity
            android:name="com.liskovsoft.smartyoutubetv2.tv.mobile.common.KamiLinkActivity"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- The watch page is a panel of the main screen since v9 (MobileBrowseActivity) -->

        <!-- SmartTube TV screens and TV entry points: never shown on a phone (they need a remote and left the app stuck).
             The code stays, so upstream updates still merge. KamishibaiApplication.TvScreenGuard is the safety net. -->
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.ui.browse.BrowseActivity" tools:node="remove" />
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.ui.channel.ChannelActivity" tools:node="remove" />
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.ui.channeluploads.ChannelUploadsActivity" tools:node="remove" />
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.ui.playback.PlaybackActivity" tools:node="remove" />
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.ui.search.tags.SearchTagsActivity" tools:node="remove" />
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.ui.signin.SignInActivity" tools:node="remove" />
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.ui.dialogs.AppDialogActivity" tools:node="remove" />
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.ui.dialogs.AppDialogActivityOpaque" tools:node="remove" />
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.ui.adddevice.AddDeviceActivity" tools:node="remove" />
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.ui.webbrowser.WebBrowserActivity" tools:node="remove" />
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.launchers.HomeLauncherActivity" tools:node="remove" />
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.launchers.NewsLauncherActivity" tools:node="remove" />
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.launchers.MusicLauncherActivity" tools:node="remove" />
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.launchers.GamesLauncherActivity" tools:node="remove" />
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.launchers.ChannelsLauncherActivity" tools:node="remove" />
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.launchers.SubscriptionsLauncherActivity" tools:node="remove" />
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.launchers.HistoryLauncherActivity" tools:node="remove" />
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.launchers.PlaylistsLauncherActivity" tools:node="remove" />
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.launchers.SearchLauncherActivity" tools:node="remove" />
        <activity-alias android:name="com.liskovsoft.smartyoutubetv2.tv.ui.main.SplashActivityAlt" tools:node="remove" />
        <!-- Android TV global search and home screen channels -->
        <activity android:name="com.liskovsoft.leanbackassistant.search.SearchableActivity" tools:node="remove" />
        <provider android:name="com.liskovsoft.leanbackassistant.search.VideoContentProvider" tools:node="remove" />
        <receiver android:name="com.liskovsoft.leanbackassistant.channels.UpdateChannelsReceiver" tools:node="remove" />

        <!-- Video downloads, one at a time, with a progress notification -->
        <service
            android:name="com.liskovsoft.smartyoutubetv2.tv.mobile.download.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
