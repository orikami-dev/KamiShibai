<?xml version="1.0" encoding="utf-8"?>
<!-- One setting or one value of a compact menu, the picked value (activated) in the accent colour -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#1A808080">
    <item>
        <selector>
            <item android:state_activated="true">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/kamiAccentSoft" />
                    <stroke android:width="1dp" android:color="?attr/kamiAccent" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/kamiSurfaceHigh" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
