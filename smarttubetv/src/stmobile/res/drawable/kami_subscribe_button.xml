<?xml version="1.0" encoding="utf-8"?>
<!-- "Subscribe" is a strong pill, "Subscribed" a quiet one -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?attr/kamiHighlight">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/kamiSurfaceHigh" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/kamiText" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
