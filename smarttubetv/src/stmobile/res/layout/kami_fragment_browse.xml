<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kami_ink"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="4dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@mipmap/app_icon"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/kami_title"
            style="@style/Kamishibai.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/app_name" />

        <ImageButton
            android:id="@+id/kami_action_search"
            style="@style/Kamishibai.IconButton"
            android:contentDescription="@string/kami_search"
            android:src="@drawable/kami_ic_search" />

        <ImageButton
            android:id="@+id/kami_action_settings"
            style="@style/Kamishibai.IconButton"
            android:contentDescription="@string/kami_settings"
            android:src="@drawable/kami_ic_settings" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Rail (foldables, landscape) or drawer (tablets) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/kami_nav_rail"
            android:layout_width="88dp"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="16dp"
            android:scrollbars="none"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/kami_refresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/kami_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="16dp"
                    android:scrollbarStyle="outsideOverlay"
                    android:scrollbars="vertical" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <include layout="@layout/kami_view_error" />

            <ProgressBar
                android:id="@+id/kami_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_gravity="top"
                android:indeterminate="true"
                android:indeterminateTint="@color/kami_accent"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Bottom bar (phones) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/kami_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/kami_surface"
        android:overScrollMode="never"
        android:visibility="gone" />
</LinearLayout>
