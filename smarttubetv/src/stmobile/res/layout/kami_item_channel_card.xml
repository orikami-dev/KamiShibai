<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/kami_ripple_card"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="12dp">

    <ImageView
        android:id="@+id/kami_thumb"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:background="@drawable/kami_round_frame"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/kami_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/kami_text"
        android:textSize="15sp"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:id="@+id/kami_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/kami_text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/kami_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/kami_badge"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:textColor="@android:color/white"
        android:textSize="11sp" />
</LinearLayout>
