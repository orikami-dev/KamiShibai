<?xml version="1.0" encoding="utf-8"?>
<!-- One row of a settings page or menu: optional radio button at the start, title and summary, switch or arrow at the end -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/kami_ripple_row"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="24dp"
    android:paddingTop="10dp"
    android:paddingEnd="20dp"
    android:paddingBottom="10dp">

    <RadioButton
        android:id="@+id/kami_row_radio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="-6dp"
        android:layout_marginEnd="12dp"
        android:background="@null"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/kami_row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/kamiText"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/kami_row_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="?attr/kamiTextSecondary"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/kami_row_chevron"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="12dp"
        android:importantForAccessibility="no"
        android:src="@drawable/kami_ic_chevron_right"
        android:tint="?attr/kamiTextSecondary"
        android:visibility="gone" />

    <Switch
        android:id="@+id/kami_row_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:background="@null"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />
</LinearLayout>
