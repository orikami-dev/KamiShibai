<?xml version="1.0" encoding="utf-8"?>
<!-- One setting of a compact menu (its name, what is picked now) or one of its values -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="3dp"
    android:background="@drawable/kami_menu_tile"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/kami_tile_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="?attr/kamiText"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/kami_tile_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/kamiAccent"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
