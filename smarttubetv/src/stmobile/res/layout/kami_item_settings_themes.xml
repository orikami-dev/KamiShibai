<?xml version="1.0" encoding="utf-8"?>
<!-- Theme entry of the Settings tab: a tap unfolds the palettes, each with a small preview. A tap on one applies it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/kami_theme_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/kami_ripple_row"
        android:gravity="center_vertical"
        android:minHeight="60dp"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/kami_ic_palette"
            android:tint="?attr/kamiTextSecondary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/kami_set_theme"
                android:textColor="?attr/kamiText"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/kami_theme_current"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="?attr/kamiTextSecondary"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/kami_theme_chevron"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/kami_ic_chevron_down"
            android:tint="?attr/kamiTextSecondary" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/kami_theme_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="60dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/kami_theme_cards"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>
</LinearLayout>
