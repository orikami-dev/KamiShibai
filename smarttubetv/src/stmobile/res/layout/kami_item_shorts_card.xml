<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/kami_ripple_card"
    android:padding="4dp">

    <com.liskovsoft.smartyoutubetv2.tv.mobile.widget.AspectFrameLayout xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/kami_thumb_frame"
        android:outlineProvider="background"
        android:clipToOutline="true"
        app:kamiRatio="0.5625">

        <ImageView
            android:id="@+id/kami_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />

        <View
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_gravity="bottom"
            android:background="@drawable/kami_shade_bottom" />

        <TextView
            android:id="@+id/kami_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:ellipsize="end"
            android:maxLines="2"
            android:padding="10dp"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />

        <ProgressBar
            android:id="@+id/kami_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:max="100"
            android:progressDrawable="@drawable/kami_watched_progress"
            android:visibility="gone" />
    </com.liskovsoft.smartyoutubetv2.tv.mobile.widget.AspectFrameLayout>
</FrameLayout>
