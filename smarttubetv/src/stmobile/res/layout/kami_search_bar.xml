<?xml version="1.0" encoding="utf-8"?>
<!-- Search field with its buttons. Shown in the top bar of Home (over the logo) and on the standalone search page. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/kami_search_bar"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="@color/kami_ink"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <ImageButton
        android:id="@+id/kami_back"
        style="@style/Kamishibai.IconButton"
        android:contentDescription="@string/kami_back"
        android:src="@drawable/kami_ic_back" />

    <LinearLayout
        android:id="@+id/kami_search_box"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:background="@drawable/kami_field"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp">

        <EditText
            android:id="@+id/kami_search_field"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/kami_search_hint"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/kami_text"
            android:textColorHint="@color/kami_text_secondary"
            android:textCursorDrawable="@null"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/kami_search_clear"
            style="@style/Kamishibai.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/kami_clear"
            android:src="@drawable/kami_ic_close"
            android:visibility="gone" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/kami_search_voice"
        style="@style/Kamishibai.IconButton"
        android:contentDescription="@string/kami_voice_search"
        android:src="@drawable/kami_ic_mic" />

    <ImageButton
        android:id="@+id/kami_search_filters"
        style="@style/Kamishibai.IconButton"
        android:contentDescription="@string/kami_search_filters"
        android:src="@drawable/kami_ic_tune" />
</LinearLayout>
