<?xml version="1.0" encoding="utf-8"?>
<!-- Shorts, laid out like the YouTube app: "Shorts" and its buttons on top, the actions in a column on the right,
     the channel, its subscribe pill and the title at the bottom left, the progress line right above the tabs. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/kami_shorts_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <View
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_gravity="top"
        android:background="@drawable/kami_shorts_shade_top" />

    <View
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_gravity="bottom"
        android:background="@drawable/kami_shorts_shade" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/kami_sh_heading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:shadowColor="#66000000"
            android:shadowRadius="3"
            android:text="@string/kami_shorts_title"
            android:textColor="@android:color/white"
            android:textSize="21sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/kami_sh_search"
            style="@style/Kamishibai.OverlayButton"
            android:contentDescription="@string/kami_search"
            android:src="@drawable/kami_ic_search" />

        <ImageButton
            android:id="@+id/kami_sh_quality"
            style="@style/Kamishibai.OverlayButton"
            android:contentDescription="@string/kami_quality"
            android:src="@drawable/kami_ic_quality" />

        <ImageButton
            android:id="@+id/kami_sh_more"
            style="@style/Kamishibai.OverlayButton"
            android:contentDescription="@string/kami_more_actions"
            android:src="@drawable/kami_ic_more_vert" />
    </LinearLayout>

    <!-- Paused indicator, in the middle -->
    <ImageView
        android:id="@+id/kami_sh_paused"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_gravity="center"
        android:background="@drawable/kami_overlay_round"
        android:importantForAccessibility="no"
        android:padding="20dp"
        android:src="@drawable/kami_ic_play"
        android:visibility="gone" />

    <!-- Actions: large icons, the count or the name under each -->
    <LinearLayout
        android:layout_width="72dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="18dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/kami_sh_like"
            style="@style/Kamishibai.ShortsAction"
            android:drawableTop="@drawable/kami_ic_thumb_up" />

        <TextView
            android:id="@+id/kami_sh_dislike"
            style="@style/Kamishibai.ShortsAction"
            android:drawableTop="@drawable/kami_ic_thumb_down"
            android:text="@string/kami_dislike" />

        <TextView
            android:id="@+id/kami_sh_comments"
            style="@style/Kamishibai.ShortsAction"
            android:drawableTop="@drawable/kami_ic_comment"
            android:text="@string/kami_comments" />

        <TextView
            android:id="@+id/kami_sh_save"
            style="@style/Kamishibai.ShortsAction"
            android:drawableTop="@drawable/kami_ic_playlist_add"
            android:text="@string/kami_save" />

        <TextView
            android:id="@+id/kami_sh_share"
            style="@style/Kamishibai.ShortsAction"
            android:drawableTop="@drawable/kami_ic_share"
            android:text="@string/kami_share" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginEnd="80dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:id="@+id/kami_sh_channel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/kami_sh_avatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/kami_round_frame"
                android:clipToOutline="true"
                android:importantForAccessibility="no"
                android:outlineProvider="background"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/kami_sh_author"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:maxWidth="170dp"
                android:shadowColor="#66000000"
                android:shadowRadius="3"
                android:textColor="@android:color/white"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/kami_sh_subscribe"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/kami_shorts_subscribe"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/kami_subscribe"
                android:textColor="@color/kami_shorts_subscribe_text"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/kami_sh_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:shadowColor="#66000000"
            android:shadowRadius="3"
            android:textColor="@android:color/white"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Right above the tabs, like YouTube -->
    <ProgressBar
        android:id="@+id/kami_sh_line"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_gravity="bottom"
        android:max="1000"
        android:progressDrawable="@drawable/kami_seek_progress" />
</FrameLayout>
