<?xml version="1.0" encoding="utf-8"?>
<!-- Shorts: vertical video, actions on the right, channel and title at the bottom left. Always visible. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/kami_shorts_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <View
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_gravity="bottom"
        android:background="@drawable/kami_shorts_shade" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:padding="4dp">

        <ImageButton
            android:id="@+id/kami_sh_back"
            style="@style/Kamishibai.OverlayButton"
            android:contentDescription="@string/kami_back"
            android:src="@drawable/kami_ic_back" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/kami_sh_quality"
            style="@style/Kamishibai.OverlayButton"
            android:contentDescription="@string/kami_quality"
            android:src="@drawable/kami_ic_quality" />

        <ImageButton
            android:id="@+id/kami_sh_more"
            style="@style/Kamishibai.OverlayButton"
            android:contentDescription="@string/kami_more_actions"
            android:src="@drawable/kami_ic_more_vert" />
    </LinearLayout>

    <!-- Paused indicator, in the middle -->
    <ImageView
        android:id="@+id/kami_sh_paused"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center"
        android:background="@drawable/kami_overlay_round"
        android:importantForAccessibility="no"
        android:padding="16dp"
        android:src="@drawable/kami_ic_play"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="84dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="28dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/kami_sh_like"
            style="@style/Kamishibai.ShortsAction"
            android:drawableTop="@drawable/kami_ic_thumb_up" />

        <TextView
            android:id="@+id/kami_sh_dislike"
            style="@style/Kamishibai.ShortsAction"
            android:drawableTop="@drawable/kami_ic_thumb_down"
            android:text="@string/kami_dislike" />

        <TextView
            android:id="@+id/kami_sh_comments"
            style="@style/Kamishibai.ShortsAction"
            android:drawableTop="@drawable/kami_ic_comment"
            android:text="@string/kami_comments" />

        <TextView
            android:id="@+id/kami_sh_save"
            style="@style/Kamishibai.ShortsAction"
            android:drawableTop="@drawable/kami_ic_playlist_add"
            android:text="@string/kami_save" />

        <TextView
            android:id="@+id/kami_sh_share"
            style="@style/Kamishibai.ShortsAction"
            android:drawableTop="@drawable/kami_ic_share"
            android:text="@string/kami_share" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginEnd="88dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingBottom="22dp">

        <LinearLayout
            android:id="@+id/kami_sh_channel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/kami_sh_avatar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/kami_round_frame"
                android:clipToOutline="true"
                android:importantForAccessibility="no"
                android:outlineProvider="background"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/kami_sh_author"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="180dp"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/kami_sh_subscribe"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/kami_subscribe_button"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/kami_subscribe"
                android:textColor="@color/kami_subscribe_text"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <TextView
            android:id="@+id/kami_sh_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@android:color/white"
            android:textSize="14sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/kami_sh_line"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_gravity="bottom"
        android:max="1000"
        android:progressDrawable="@drawable/kami_seek_progress" />
</FrameLayout>
