<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/kami_error"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    android:visibility="gone">

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/kami_ic_error"
        android:tint="@color/kami_text_secondary"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/kami_error_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:maxWidth="420dp"
        android:textColor="@color/kami_text"
        android:textSize="16sp" />

    <Button
        android:id="@+id/kami_error_action"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/kami_button"
        android:minWidth="160dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:stateListAnimator="@null"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="15sp" />
</LinearLayout>
