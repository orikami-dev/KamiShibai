<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Day versions of the interface palettes, applied over Kamishibai.Theme (see KamiTheme). Washi is the theme itself. -->
    <style name="Kamishibai.Palette.Washi" parent="">
        <item name="kamiLogo">@drawable/kami_logo</item>
    </style>
    <style name="Kamishibai.Palette.Sumi" parent="">
        <item name="kamiLogo">@drawable/kami_logo_sumi</item>
        <item name="kamiInk">@color/kami_pal_day_sumi_ink</item>
        <item name="kamiSurface">@color/kami_pal_day_sumi_surface</item>
        <item name="kamiSurfaceHigh">@color/kami_pal_day_sumi_surface_high</item>
        <item name="kamiFill">@color/kami_pal_day_sumi_fill</item>
        <item name="kamiBar">@color/kami_pal_day_sumi_bar</item>
        <item name="kamiOutline">@color/kami_pal_day_sumi_outline</item>
        <item name="kamiText">@color/kami_pal_day_sumi_text</item>
        <item name="kamiTextSecondary">@color/kami_pal_day_sumi_text_secondary</item>
        <item name="kamiShimmerA">@color/kami_pal_day_sumi_shimmer_a</item>
        <item name="kamiShimmerB">@color/kami_pal_day_sumi_shimmer_b</item>
        <item name="kamiAccent">@color/kami_pal_day_sumi_accent</item>
        <item name="kamiAccentSoft">@color/kami_pal_day_sumi_accent_soft</item>
    </style>
    <style name="Kamishibai.Palette.Ai" parent="">
        <item name="kamiLogo">@drawable/kami_logo_ai</item>
        <item name="kamiAccent">@color/kami_pal_day_ai_accent</item>
        <item name="kamiAccentSoft">@color/kami_pal_day_ai_accent_soft</item>
    </style>
    <style name="Kamishibai.Palette.Matcha" parent="">
        <item name="kamiLogo">@drawable/kami_logo_matcha</item>
        <item name="kamiAccent">@color/kami_pal_day_matcha_accent</item>
        <item name="kamiAccentSoft">@color/kami_pal_day_matcha_accent_soft</item>
    </style>
    <style name="Kamishibai.Palette.Sakura" parent="">
        <item name="kamiLogo">@drawable/kami_logo_sakura</item>
        <item name="kamiAccent">@color/kami_pal_day_sakura_accent</item>
        <item name="kamiAccentSoft">@color/kami_pal_day_sakura_accent_soft</item>
    </style>
    <style name="Kamishibai.Palette.Kin" parent="">
        <item name="kamiLogo">@drawable/kami_logo_kin</item>
        <item name="kamiAccent">@color/kami_pal_day_kin_accent</item>
        <item name="kamiAccentSoft">@color/kami_pal_day_kin_accent_soft</item>
    </style>
</resources>
